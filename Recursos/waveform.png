<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 100" width="100%" height="100%">
  <defs>
    <!-- Filtro de resplandor para el efecto neón -->
    <filter id="neonGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2.5" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
    
    <!-- Gradiente lineal para desvanecer la línea central en los extremos -->
    <linearGradient id="lineFade" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#003388" stop-opacity="0" />
      <stop offset="25%" stop-color="#0055ff" stop-opacity="0.8" />
      <stop offset="75%" stop-color="#0055ff" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#003388" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- Fondo oscuro (Puedes eliminar esta línea para hacerlo transparente) -->
  <rect id="fondo" width="400" height="100" fill="#060c18" />

  <!-- Línea base horizontal con difuminado en las puntas -->
  <line x1="20" y1="50" x2="380" y2="50" stroke="url(#lineFade)" stroke-width="1.5" filter="url(#neonGlow)" />

  <!-- Conjunto de bucles de la onda de voz -->
  <g fill="none" stroke="#0066ee" stroke-width="1.5" filter="url(#neonGlow)">
    
    <!-- Lado Izquierdo -->
    <rect x="98" y="46" width="4" height="8" rx="2" />
    <rect x="106" y="43" width="6" height="14" rx="3" />
    <rect x="116" y="38" width="6" height="24" rx="3" />
    <rect x="126" y="28" width="8" height="44" rx="4" />
    <rect x="138" y="34" width="8" height="32" rx="4" />
    <rect x="150" y="20" width="10" height="60" rx="5" />
    <rect x="164" y="36" width="10" height="28" rx="5" />
    <rect x="178" y="26" width="12" height="48" rx="6" />
    
    <!-- Bucle Central (Más alto) -->
    <rect x="194" y="15" width="12" height="70" rx="6" />
    
    <!-- Lado Derecho -->
    <rect x="210" y="30" width="10" height="40" rx="5" />
    <rect x="224" y="22" width="10" height="56" rx="5" />
    <rect x="238" y="35" width="8" height="30" rx="4" />
    <rect x="250" y="28" width="8" height="44" rx="4" />
    <rect x="262" y="38" width="6" height="24" rx="3" />
    <rect x="272" y="42" width="6" height="16" rx="3" />
    <rect x="282" y="45" width="4" height="10" rx="2" />
  </g>
  
  <!-- Trazos internos brillantes para darle un centro más definido a la luz -->
  <g fill="none" stroke="#66bbff" stroke-width="0.8" opacity="0.9">
    <rect x="194" y="15" width="12" height="70" rx="6" />
    <rect x="150" y="20" width="10" height="60" rx="5" />
    <rect x="224" y="22" width="10" height="56" rx="5" />
    <rect x="178" y="26" width="12" height="48" rx="6" />
    <rect x="250" y="28" width="8" height="44" rx="4" />
    <rect x="126" y="28" width="8" height="44" rx="4" />
  </g>
</svg>
